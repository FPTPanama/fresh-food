{
  "name": "fresh-food-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "dev:web": "npm run dev --workspace=web",
    "dev:studio": "npm run dev --workspace=studio",
    "build": "npm run build --workspace=web",
    "build:web": "npm run build --workspace=web",
    "lint": "npm run lint --workspace=web",
    "clean": "rm -rf node_modules apps/*/node_modules apps/*/.next"
  },
  "devDependencies": {
    "react-is": "^19.2.4",
    "turbo": "^2.3.0"
  },
  "packageManager": "npm@10.2.0"
}
